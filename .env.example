DISCORD_TOKEN=your_discord_bot_token_here

# OpenAI-compatible backend (required)
API_KEY=your_openai_api_key_here
BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
TIME_OUT_SECONDS=25

# Prompt/decoding profile
# If unset/blank, runtime defaults to yeti_small.
# Set auto to use yeti_small for tiny model names (0.5b/q8/bf16), else yeti_large.
YETI_PROMPT_PROFILE=
YETI_SMALL_TEMPERATURE=0
YETI_LARGE_TEMPERATURE=0.2
YETI_SMALL_MAX_TOKENS=260
YETI_LARGE_MAX_TOKENS=480
YETI_SMALL_MODEL_NAME=himalaya-bf16
YETI_SMALL_HISTORY_LIMIT=1
YETI_LARGE_HISTORY_LIMIT=2
YETI_INCLUDE_BOT_HISTORY=
# Default: false for yeti_small, true for yeti_large.
YETI_ENABLE_VALIDATOR_RETRY=
# Max LLM rewrite attempts after validator issues remain.
YETI_VALIDATOR_MAX_RETRIES=3
# If validator text leaks into output, retry rewriting before fallback.
YETI_LEAK_RECOVERY_MAX_RETRIES=3
# Keep the small profile tool surface minimal and stable.
YETI_SMALL_TOOLS=get_nepal_live_context,internet_search,fetch_url
# Optional comma-separated stop sequences.
YETI_STOP_TOKENS=

# NepalOSINT configuration
NEPALOSINT_BASE_URL=https://nepalosint.com/api/v1
NEPALOSINT_PUBLIC_AUTH_ENABLED=true
NEPALOSINT_TIMEOUT_SECONDS=8
NEPALOSINT_MAX_CONTEXT_ITEMS=8

# Automatic #social-media feed
YETI_SOCIAL_FEED_ENABLED=true
# Optional: pin to a channel ID. If blank, YetiDai finds a channel named
# social-media, including emoji-prefixed names like "📱・social-media".
YETI_SOCIAL_CHANNEL_ID=
YETI_SOCIAL_CHANNEL_NAME=social-media
YETI_SOCIAL_POLL_SECONDS=300
YETI_SOCIAL_STATE_DB=logs/social_feed.sqlite3
YETI_SOCIAL_POST_EXISTING_ON_FIRST_RUN=false
YETI_SOCIAL_MAX_POSTS_PER_POLL=25
# Comma-separated X/Twitter handles. Defaults to the AI list in code.
YETI_SOCIAL_ACCOUNTS=
YETI_SOCIAL_NITTER_INSTANCES=https://nitter.poast.org,https://nitter.privacydev.net
YETI_SOCIAL_INCLUDE_RETWEETS=false
YETI_SOCIAL_INCLUDE_REPLIES=false

INTRO_CHANNEL_ID=
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PROJECT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_PRIVATE_KEY=
